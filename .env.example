# Add your Steam API key here (do NOT commit sensitive keys to git)
VITE_STEAM_API_KEY=your_steam_api_key_here

# Usage: create a file named .env.local with this variable set, for example:
# VITE_STEAM_API_KEY=B19ABBC972B7D7C24E12F08438F3EBA7
# Then restart the dev server (npm run dev) so Vite picks up the new env var.
